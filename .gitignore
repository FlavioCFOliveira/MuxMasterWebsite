/bin/
/dist/
/tmp/
*.test
*.out
coverage.*

# Tailwind standalone CLI binary (downloaded by `make tailwind-install`)
/bin/tailwindcss
/bin/tailwindcss-*

# Generated CSS bundle (hashed, build artefact). Keep app.css source.
/static/css/app.*.css

# Image artefacts produced by `make assets` from the canonical
# tools/imagegen/source.png build input. The source PNG is committed
# (under tools/imagegen/ rather than under static/, because it is a
# build input not a runtime asset and must not be publicly served);
# every derivative (sized header logos, favicons, apple-touch-icons,
# the 1200x630 OG composition) is regenerated deterministically at
# build time and never committed.
/static/img/logo-*.png
/static/img/logo-*.webp
/static/img/logo-*.avif
/static/img/og-image.png
/static/img/og-image-*.png
/static/img/og-image-*.webp
/static/img/og-image-*.avif

# Generated favicons (build-time output of `make assets`).
/static/favicon/favicon.png
/static/favicon/favicon-*.png
/static/favicon/apple-touch-icon-*.png
/static/favicon/*.ico

# IDE / OS artefacts.
.idea/
.vscode/
.DS_Store
